# Dream Walk Scores — environment variables.
#
# Every one of these is optional. With an empty environment the service starts and answers
# requests by computing live from free public data sources.

# --- Database -----------------------------------------------------------------
# Optional. Without it the service computes every request live from Overpass; with it you
# get the shared score cache, the precomputed grid and GTFS-backed Transit Scores.
DATABASE_URL=postgresql://dws:dws@localhost:5432/dws
PGSSLMODE=
PG_POOL_MAX=6
PG_STATEMENT_TIMEOUT_MS=15000

# --- Public identity ------------------------------------------------------------
# Used for the links in the Walk Score compatibility response. Inferred per-request when unset.
PUBLIC_BASE_URL=

# --- Authentication ---------------------------------------------------------------
# The API is open by default, which is what the sibling Dream products expect.
REQUIRE_API_KEY=
STATIC_API_KEY=
ANON_RATE_LIMIT_PER_MINUTE=60
KEY_RATE_LIMIT_PER_MINUTE=600

# Enables /admin. The dashboard is unavailable until this is set.
ADMIN_PASSWORD=

# --- AI explanations ----------------------------------------------------------
# Optional and opt-in per request via `ai=1`. Scores never depend on the model being
# available; on any failure the deterministic template is returned instead.
OPENAI_API_KEY=
AI_EXPLAIN_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_EXPLAIN_MAX_TOKENS=220
AI_TIMEOUT_MS=8000
# Used only to estimate spend on the admin dashboard; update when changing model.
AI_COST_PER_MTOK_IN=0.15
AI_COST_PER_MTOK_OUT=0.6

# --- Upstream data ------------------------------------------------------------
# Overpass mirrors, tried in order. Point at a self-hosted instance to drop the dependency
# on the public ones — worth doing at any real traffic volume.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.osm.jp/api/interpreter
OVERPASS_TIMEOUT_MS=45000
OSM_CACHE_TTL_MS=3600000

# Free AWS terrain tiles: no key, no rate limit.
TERRAIN_TILE_BASE=https://s3.amazonaws.com/elevation-tiles-prod/terrarium
TERRAIN_TILE_ZOOM=12

# --- Caching and limits --------------------------------------------------------
SCORE_CELL_METERS=25
SCORE_MEMORY_TTL_MS=21600000
SCORE_MEMORY_ENTRIES=5000
SCORE_DB_TTL_DAYS=30
BATCH_MAX_POINTS=100
BATCH_CONCURRENCY=4
